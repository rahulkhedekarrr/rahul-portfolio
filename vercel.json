{
  "redirects": [
    {
      "source": "/projects/replybox",
      "destination": "/projects/ai-email-assistant",
      "permanent": true
    },
    {
      "source": "/projects/replybox/",
      "destination": "/projects/ai-email-assistant",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)$",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
